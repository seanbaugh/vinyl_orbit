# Discogs account whose public collection is synced
DISCOGS_USERNAME=seanmikel
# Optional personal access token (Discogs > Settings > Developers). Raises rate limit; not required.
DISCOGS_TOKEN=
# Your time zone — decides where months start for "plays this month" (e.g. America/New_York)
TZ=America/Los_Angeles
# (Port and data location are fixed in docker-compose.yml; to use another host port, edit the ports: mapping there.)
# Scheduled sync interval in hours (0 disables scheduled sync)
SYNC_INTERVAL_HOURS=6
# Re-fetch release details (prices, ratings) after this many days
DETAIL_REFRESH_DAYS=7
# Max out-of-date releases refreshed per scheduled sync
DETAIL_REFRESH_PER_RUN=15
# Marketplace currency
CURRENCY=USD
